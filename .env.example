# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...        # সার্ভার ছাড়া কোথাও ব্যবহার করবেন না

# ---------- Meta Pixel + Conversions API ----------
NEXT_PUBLIC_FB_PIXEL_ID=1234567890123456
FB_CAPI_ACCESS_TOKEN=EAAG...                    # Events Manager > Settings > Conversions API
FB_TEST_EVENT_CODE=                             # সেটআপের সময় TEST1234, লাইভে খালি রাখুন
FB_API_VERSION=v21.0

# ---------- Pathao Courier (site.ts → courier: 'pathao') ----------
# Pathao মার্চেন্ট প্যানেল → Developer's API → Merchant API Credentials
PATHAO_BASE_URL=https://api-hermes.pathao.com      # টেস্টে https://courier-api-sandbox.pathao.com
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=                                 # মার্চেন্ট প্যানেলের লগইন ইমেইল
PATHAO_PASSWORD=                                 # মার্চেন্ট প্যানেলের পাসওয়ার্ড
PATHAO_STORE_ID=                                 # Stores পাতায় স্টোরের আইডি
PATHAO_WEBHOOK_SECRET=                           # Developer's API → Webhook-এ দেখানো সিক্রেট
PATHAO_WEBHOOK_PATH=                             # নিজে বানানো লম্বা র‍্যান্ডম লেখা — ওয়েবহুক URL-এর শেষ অংশ

# ---------- Steadfast Courier (site.ts → courier: 'steadfast' হলে) ----------
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_WEBHOOK_SECRET=                        # নিজে একটা র‍্যান্ডম স্ট্রিং বানিয়ে দিন

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=https://example.com          # ডোমেইন — src/config/site.ts-এও বসান
REVALIDATE_SECRET=                               # নিজে একটা র‍্যান্ডম স্ট্রিং বানিয়ে দিন
